# Serves the built frontend and forwards API calls to the backend.
# The official nginx image fills in ${BACKEND_URL} at container start:
#   docker compose:  http://backend:8080           (the compose service)
#   Azure:           http://ca-agentlab-api         (the internal Container App)

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Password protection when BASIC_AUTH_PASSWORD is set (Azure). Empty file otherwise.
    include /etc/nginx/auth.conf;

    # Health probe for Docker / Azure: never behind the password
    location = /healthz {
        auth_basic off;
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # API, docs and schema -> FastAPI
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $proxy_host;   # Azure Container Apps routes on the Host header
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";   # the site password is not the API's business
        proxy_read_timeout 300s;
    }
    location /docs {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $proxy_host;
    }
    location = /openapi.json {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $proxy_host;
    }

    # Hashed build files never change: cache them for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths (e.g. /agents/123) load index.html and React Router takes over.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
