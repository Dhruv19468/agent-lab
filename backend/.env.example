# Copy this file to backend/.env and fill in the values before starting the app.
# Every variable maps 1:1 to a field on Settings in app/core/config.py (case-insensitive).

# --- App metadata ------------------------------------------------------------
APP_NAME=Agent-Lab
PROJECT_DESCRIPTION=Practice agent platform: skills, tools and agents on Azure OpenAI.
ENVIRONMENT=development
API_PREFIX=/api
ROOT_PATH=
DOCS_PATH=/docs
OPENAPI_PATH=/openapi.json
INCLUDE_OPENAPI_DOCS=true

# --- Startup behaviour --------------------------------------------------------
# Runs `alembic upgrade head` automatically during API startup.
RUN_ALEMBIC_ON_STARTUP=true

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/agent_lab_db
DATABASE_SCHEMA=al

# --- CORS ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Azure OpenAI (a model deployed in Azure AI Foundry) ---------------------
# The v1 base URL of the resource, ending in /openai/v1/
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_TIMEOUT_SECONDS=180
AZURE_OPENAI_MAX_RETRIES=2
# The model that scores plans. Empty = same as AZURE_OPENAI_DEPLOYMENT.
EVAL_JUDGE_DEPLOYMENT=

# --- Agent data and catalog ---------------------------------------------------
# Folder the agent's file tools can see (relative to backend/). Docker/Azure use /data.
AGENT_DATA_DIR=../data
# Create the built-in tools, the "BRD to Test Plan" skill and the "Test Plan Agent" if missing
SYNC_CATALOG_ON_STARTUP=true

# --- More models for the dropdowns (comma-separated deployment names) ----------
AZURE_OPENAI_DEPLOYMENTS=gpt-4.1,o4-mini

# --- Azure AI Foundry: Publish registers the agent in this project --------------
# Foundry portal > your project > Overview > "Project endpoint". Empty = publish inside Agent Lab only.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# entra = your `az login` (needs the "Azure AI User" role on the Foundry resource)
FOUNDRY_AUTH_MODE=entra

# --- Where the agent's data lives ----------------------------------------------
# local = the folder AGENT_DATA_DIR (your laptop). blob = an Azure Blob container (Azure).
AGENT_STORAGE=local
# For AGENT_STORAGE=blob (set by deploy/azure/setup.ps1 on Azure):
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=agentdata
# Long plans need more than the default 3 minutes per model call
AZURE_OPENAI_TIMEOUT_SECONDS=600
